# Frontend
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend
DATABASE_URL=postgresql://ggs:desarrollo-local@localhost:5432/ggs_document_studio?schema=public
SHADOW_DATABASE_URL=postgresql://ggs:desarrollo-local@localhost:5432/ggs_document_studio_shadow?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Use SUPABASE_JWT_SECRET for legacy HS256 projects, or SUPABASE_JWKS_URL for asymmetric signing.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
PORT=3000
# In development, localhost/127.0.0.1 ports are accepted so Vite can fall back to 5174 when 5173 is busy.
# In production, add every public frontend origin. Wildcard subdomains are supported, for example https://*.vercel.app.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://web-ggs-e214.vercel.app
# Backend-only bootstrap email for the first SUPERADMIN role assignment.
SUPERADMIN_EMAIL=admin@example.com
DEFAULT_ORGANIZATION_SLUG=demo-organization
# Private Supabase Storage bucket used by the backend.
STORAGE_BUCKET=ggs-documents
# Optional DOC/DOCX -> PDF conversion. Install LibreOffice in the backend environment and point this to soffice/libreoffice when needed.
LIBREOFFICE_BIN=soffice
DOCUMENT_CONVERSION_TIMEOUT_MS=30000
